# Copy to .env.local and fill in once a real Sanity project exists.
# Without this file, the site and /studio run in "not connected" mode —
# pages render sample content, and /studio will show a connection error.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Only needed to run scripts/seed.mjs (sample content seeding). Create a
# token with Editor access at https://www.sanity.io/manage — do not commit it.
SANITY_API_WRITE_TOKEN=

# Powers both lead-capture forms' real backend (src/app/api/leads/route.ts) —
# "Talk to KIBO" (source: "enquiry") and "Download Catalog"
# (source: "catalog_download") — added 30 Aug 2026, superseding the earlier
# Resend-based /api/enquiry route (deleted). Owner decision: a free Google
# Apps Script Web App that appends each submission to a Google Sheet, chosen
# over Zapier specifically because Zapier's free tier caps at 100 tasks/month
# and one action per Zap. Without this set, submissions are only logged to
# the server console, not sent anywhere. Point this at whatever webhook you
# want — a Google Apps Script Web App URL, a Zapier/Make webhook, a CRM
# endpoint, anything that accepts a POST of
# { timestamp, source, name, email, phone, productInterest } — this route
# has no provider-specific logic, so repointing this URL is the only change
# needed to switch destinations.
LEADS_WEBHOOK_URL=
